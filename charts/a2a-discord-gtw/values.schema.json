{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "snowflake": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "A Discord ID, as a quoted string"
    },
    "k8sLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["image", "discordToken", "config", "persistence", "healthPort"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "discordToken": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discord", "kagent", "agents"],
      "properties": {
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guild_id", "category_id", "allowed_user_ids"],
          "properties": {
            "guild_id": { "$ref": "#/definitions/snowflake" },
            "category_id": { "$ref": "#/definitions/snowflake" },
            "allowed_user_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/snowflake" }
            },
            "notify_user_ids": {
              "type": "array",
              "items": { "$ref": "#/definitions/snowflake" }
            }
          }
        },
        "kagent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "pattern": "^https?://[^/]+" },
            "user_id": { "type": "string" }
          }
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
              "description": "A Go duration, at least 5s"
            }
          }
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ref"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_-]{1,100}$" },
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "watch": { "type": "boolean" }
            }
          }
        }
      }
    },
    "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "warning", "error"] },
    "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]
          }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "podAnnotations": { "type": "object" },
    "podLabels": { "$ref": "#/definitions/k8sLabels" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/k8sLabels" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "podLabels": { "$ref": "#/definitions/k8sLabels" }
          }
        },
        "kagent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "podLabels": { "$ref": "#/definitions/k8sLabels" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "discordFQDNs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "matchName": { "type": "string" },
              "matchPattern": { "type": "string" }
            }
          }
        },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    }
  }
}
